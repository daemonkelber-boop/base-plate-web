<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd template: auto-update the TAPP Base Plate web app on the Mac mini.

  Every 5 minutes this runs scripts/update-from-github.sh, which pulls
  the latest code from the private GitHub repo base-plate-web
  (fast-forward only), syntax-checks it (rolling back on failure), and
  restarts the app via launchd if the app service is loaded. When nothing
  changed on GitHub it exits quietly. Log:
  __PROJECT_DIR__/logs/update.log

  Install (or let scripts/install-mini-services.sh do it for you):
    1. Let scripts/install-mini-services.sh fill in __PROJECT_DIR__ (see above).
    2. cp com.user.base-plate-web-updater.plist ~/Library/LaunchAgents/
    3. launchctl load ~/Library/LaunchAgents/com.user.base-plate-web-updater.plist

  Stop: launchctl unload ~/Library/LaunchAgents/com.user.base-plate-web-updater.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.user.base-plate-web-updater</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__PROJECT_DIR__/scripts/update-from-github.sh</string>
	</array>

	<key>WorkingDirectory</key>
	<string>__PROJECT_DIR__</string>

	<key>RunAtLoad</key>
	<true/>

	<key>StartInterval</key>
	<integer>300</integer>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>

	<key>StandardOutPath</key>
	<string>__PROJECT_DIR__/logs/updater.log</string>

	<key>StandardErrorPath</key>
	<string>__PROJECT_DIR__/logs/updater-error.log</string>
</dict>
</plist>
