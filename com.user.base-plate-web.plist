<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd template for the Base Plate web app (Mac mini, always-on).

  Before installing:
    1. Do NOT edit this file by hand: scripts/install-mini-services.sh
       replaces __PROJECT_DIR__ with the folder this repo actually lives
       in (e.g. ~/Documents/Projects/base-plate-web). Installing a copy
       of this template unchanged will point launchd at the wrong folder.
    2. Do a first manual run BEFORE installing this plist, so you know
       the password gate works: cd to this folder && python3 server.py
    3. The app binds 127.0.0.1:8512 only. Sharing is via Tailscale Funnel
       (see README.md); Funnel is a separate command, not this job.

  Install (or let scripts/install-mini-services.sh do it for you):
    ./scripts/install-mini-services.sh   (fills in __PROJECT_DIR__ for you)

  Stop:
    launchctl unload ~/Library/LaunchAgents/com.user.base-plate-web.plist

  Logs: __PROJECT_DIR__/logs/app.log (and app-error.log)
  Note: a restart drops in-memory login sessions — just log in again.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.user.base-plate-web</string>

	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>__PROJECT_DIR__/server.py</string>
	</array>

	<key>WorkingDirectory</key>
	<string>__PROJECT_DIR__</string>

	<key>RunAtLoad</key>
	<true/>

	<key>KeepAlive</key>
	<true/>

	<key>ThrottleInterval</key>
	<integer>10</integer>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>

	<key>StandardOutPath</key>
	<string>__PROJECT_DIR__/logs/app.log</string>

	<key>StandardErrorPath</key>
	<string>__PROJECT_DIR__/logs/app-error.log</string>
</dict>
</plist>
